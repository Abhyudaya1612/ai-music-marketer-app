# Copy to .env for local development
APP_ENVIRONMENT=development
APP_DATABASE_URL=sqlite:///./music_marketer.db
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# API Token (required): Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters in production. Empty allows unauthenticated local access.
APP_API_TOKEN=replace-with-a-long-random-local-token
APP_AUTH_USER_ID=local-artist
APP_MEDIA_STORAGE_PATH=./private-media
APP_MAX_UPLOAD_BYTES=52428800
APP_MAX_AUDIO_DURATION_SECONDS=900
APP_FFMPEG_PATH=ffmpeg
APP_FFPROBE_PATH=ffprobe
APP_AI_PROVIDER=mock
# Optional: configure both values to enable server-side OpenRouter reporting.
# APP_OPENROUTER_API_KEY=
# APP_OPENROUTER_MODEL=
# Token Encryption Key (required for production): Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and private; losing it makes stored OAuth tokens unreadable.
# APP_TOKEN_ENCRYPTION_KEY=
APP_FRONTEND_URL=http://localhost:3000
# Rate Limiting (security): 
# APP_RATE_LIMIT_ENABLED=true
# APP_RATE_LIMIT_AUTH_PER_MINUTE=10
# APP_RATE_LIMIT_UPLOAD_PER_HOUR=20
# APP_RATE_LIMIT_ANALYSIS_PER_HOUR=10
# Configure provider apps and register the exact callback URLs below before enabling a connection.
# YouTube requires the YouTube Data API and its read-only scope.
# APP_YOUTUBE_OAUTH_CLIENT_ID=
# APP_YOUTUBE_OAUTH_CLIENT_SECRET=
# APP_YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/oauth/callback/youtube
# Instagram Login is for professional accounts; only instagram_business_basic is requested.
# APP_INSTAGRAM_OAUTH_CLIENT_ID=
# APP_INSTAGRAM_OAUTH_CLIENT_SECRET=
# APP_INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/oauth/callback/instagram
# Facebook requests public_profile only; Pages and publishing permissions are not requested.
# APP_FACEBOOK_OAUTH_CLIENT_ID=
# APP_FACEBOOK_OAUTH_CLIENT_SECRET=
# APP_FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/oauth/callback/facebook
APP_META_GRAPH_API_VERSION=v24.0
